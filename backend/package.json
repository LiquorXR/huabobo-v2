{
  "name": "zhijiansu-backend",
  "version": "1.0.0",
  "description": "指间塑 — Node.js 后台 API（MongoDB）",
  "main": "src/index.js",
  "scripts": {
    "prestart": "node scripts/check-deps.js",
    "start": "node src/index.js",
    "dev": "node scripts/check-deps.js && node src/index.js",
    "seed": "node src/seed.js",
    "build:admin-thumb": "node_modules/esbuild/bin/esbuild scripts/admin-thumb-entry.mjs --bundle --format=iife --global-name=AdminModelThumbBundle --outfile=public/admin/vendor/admin-thumb.bundle.js --platform=browser --target=es2018",
    "postinstall": "node -e \"console.log('[ok] 依赖安装完成，可执行 npm start')\""
  },
  "engines": {
    "node": ">=16.9.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "marked": "^15.0.7",
    "mongoose": "^7.8.6",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1"
  }
}
