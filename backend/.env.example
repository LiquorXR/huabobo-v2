# 服务器：8.160.184.132
# API：http://8.160.184.132:3000 · 管理后台：http://8.160.184.132:3000/admin/
# 接口文档见 README.md

# 服务端口
PORT=3000

# MongoDB（与程序同机时一般用 127.0.0.1）
# 密码含 @ 等特殊字符时请 URL 编码（@ → %40）
MONGODB_URI=mongodb://mydb:YOUR_PASSWORD@127.0.0.1:27017/mydb?authSource=mydb

# JWT 密钥（生产环境务必改为随机长字符串）
JWT_SECRET=change-me-to-a-long-random-string

# 管理员 token 有效期（如 7d、24h）
JWT_EXPIRES_IN=7d

# 可选：覆盖代码内固定管理员账号（不填则使用 src/config.js 默认值）
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=your-strong-password

# 对外访问根 URL（用于 /uploads 上传图）
PUBLIC_BASE_URL=http://8.160.184.132:3000

# 上传文件持久化目录（须对运行 Node 的用户可写；无权限时会自动改用项目内 uploads）
# 示例（先 mkdir / chown 再启用）：
#   mkdir -p /var/lib/zhijiansu/uploads && chown -R www:www /var/lib/zhijiansu/uploads
# UPLOAD_DIR=/var/lib/zhijiansu/uploads

# 前端静态站地址（用于 images/news-*.jpg 等在管理后台显示）
FRONTEND_BASE_URL=http://8.160.184.132
