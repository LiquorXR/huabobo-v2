# 本地开发默认连本机；生产由 docker-compose 注入环境变量
# 接口文档见 README.md

# 服务端口
PORT=3000

# 数据库（二选一）
# 生产 PostgreSQL：DATABASE_URL=postgres://USER:PASS@127.0.0.1:5432/mydb
# 本地 SQLite（默认，零依赖，文件在 backend/dev.db）：DATABASE_URL=file:./dev.db
# 密码含 @ 等特殊字符时请 URL 编码（@ → %40）
DATABASE_URL=file:./dev.db

# JWT 密钥（生产环境务必改为随机长字符串）
JWT_SECRET=change-me-to-a-long-random-string
# 管理员 token 有效期（如 7d、24h）
JWT_EXPIRES_IN=7d

# 数字人语音 + 识图 + 点评（推荐：智谱单 Key，一个 key 通吃；密钥绝不进前端）
# 去智谱开放平台 > API Keys 创建复制：https://bigmodel.cn/usercenter/proj-mgmt/apikeys
# ZHIPU_API_KEY=你的智谱Key
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 识图和点评共用同一个多模态模型（视觉模型兼容纯文本），只配 VISION 则点评自动复用它
# ZHIPU_VISION_MODEL=glm-5.3-flash
# ZHIPU_TEXT_MODEL=glm-5.3-flash
# ZHIPU_TTS_MODEL=glm-tts
# ZHIPU_TTS_VOICE=tongtong
# ZHIPU_TTS_SPEED=1.0
# ZHIPU_TTS_VOLUME=1.0
# ZHIPU_REASONING_EFFORT=low
# （兼容老配置：ZHIPU_API_KEY 存在时优先走智谱，否则走下面豆包+方舟）
# 数字人语音（豆包 TTS 大模型）
# API Key 去火山引擎控制台 > API Key 管理获取；speaker 去控制台 > 音色库试听后填 ID
# DOUBAO_TTS_API_KEY=your-doubao-api-key
# DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
# DOUBAO_TTS_SPEAKER=zh_female_xxx_bigtts

# 数字人识图 + 点评文案（火山方舟 Ark，不填则用本地规则兜底）
# ARK_API_KEY 去方舟控制台 > API Key 管理创建（sk- 开头）
# ARK_VISION_MODEL / ARK_TEXT_MODEL 去方舟控制台 > 模型广场选模型填 ID
# ARK_API_KEY=sk-xxxx
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# ARK_VISION_MODEL=your-vision-model-id
# ARK_TEXT_MODEL=your-text-model-id

# 可选：覆盖代码内固定管理员账号（不填则使用 src/config.js 默认值）
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=your-strong-password

# 对外访问根 URL（用于 /uploads 上传图）
PUBLIC_BASE_URL=http://127.0.0.1:3000

# 上传文件持久化目录（须对运行 Node 的用户可写；无权限时会自动改用项目内 uploads）
# 示例（先 mkdir / chown 再启用）：
#   mkdir -p /var/lib/zhijiansu/uploads && chown -R www:www /var/lib/zhijiansu/uploads
# UPLOAD_DIR=/var/lib/zhijiansu/uploads

# 前端静态站地址（用于 images/news-*.jpg 等在管理后台显示）
FRONTEND_BASE_URL=http://127.0.0.1:8765
