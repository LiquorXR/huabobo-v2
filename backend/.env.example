# 本地开发默认连本机；生产由 docker-compose 注入环境变量
# 接口文档见 README.md

# 服务端口
PORT=3000

# 数据库（二选一）
# 生产 PostgreSQL：DATABASE_URL=postgres://USER:PASS@127.0.0.1:5432/mydb
# 本地 SQLite（默认，零依赖，文件在 backend/dev.db）：DATABASE_URL=file:./dev.db
# 密码含 @ 等特殊字符时请 URL 编码（@ → %40）
DATABASE_URL=file:./dev.db

# JWT 密钥（生产环境务必改为随机长字符串）
JWT_SECRET=change-me-to-a-long-random-string
# 管理员 token 有效期（如 7d、24h）
JWT_EXPIRES_IN=7d

# 数字人语音（豆包 TTS 大模型，密钥绝不进前端）
# API Key 去火山引擎控制台 > API Key 管理获取；speaker 去控制台 > 音色库试听后填 ID（如 40 岁女声）
# DOUBAO_TTS_API_KEY=your-doubao-api-key
# DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
# DOUBAO_TTS_SPEAKER=zh_female_xxx_bigtts

# 可选：覆盖代码内固定管理员账号（不填则使用 src/config.js 默认值）
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=your-strong-password

# 对外访问根 URL（用于 /uploads 上传图）
PUBLIC_BASE_URL=http://127.0.0.1:3000

# 上传文件持久化目录（须对运行 Node 的用户可写；无权限时会自动改用项目内 uploads）
# 示例（先 mkdir / chown 再启用）：
#   mkdir -p /var/lib/zhijiansu/uploads && chown -R www:www /var/lib/zhijiansu/uploads
# UPLOAD_DIR=/var/lib/zhijiansu/uploads

# 前端静态站地址（用于 images/news-*.jpg 等在管理后台显示）
FRONTEND_BASE_URL=http://127.0.0.1:8765
