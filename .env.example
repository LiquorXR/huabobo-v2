# 生产部署配置：cp .env.example .env 后填写
# 仅供 docker compose 使用；本地开发改 backend/.env（默认 SQLite 零配置）

# 站点域名（Caddy 自动申请 HTTPS 证书，如 www.example.com）
# DOMAIN=www.example.com

# PostgreSQL（compose 内服务名 postgres，勿改主机名）
POSTGRES_USER=mydb
POSTGRES_PASSWORD=请改为随机强密码
POSTGRES_DB=mydb

# JWT 密钥（生产务必改为随机长字符串）
JWT_SECRET=请改为随机长字符串
# 管理员 token 有效期（默认 7d，如 24h）
# JWT_EXPIRES_IN=7d

# 可选：覆盖内置管理员账号（不填则用 admin / zhijiansu@admin，首次登录后务必改密码）
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=请改为强密码

# 数字人语音 + 识图 + 点评（推荐：智谱单 Key，一个 key 通吃三件事）
# 去 https://bigmodel.cn/usercenter/proj-mgmt/apikeys 创建复制
# ZHIPU_API_KEY=你的智谱Key
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 识图和点评共用同一个多模态模型（视觉模型兼容纯文本），只配 VISION 则点评自动复用它
# ZHIPU_VISION_MODEL=glm-5.3-flash
# ZHIPU_TEXT_MODEL=glm-5.3-flash
# ZHIPU_TTS_MODEL=glm-tts
# ZHIPU_TTS_VOICE=tongtong
# ZHIPU_TTS_SPEED=1.0
# ZHIPU_TTS_VOLUME=1.0
# ZHIPU_REASONING_EFFORT=low
# （兼容老配置：豆包 TTS + 方舟识图；ZHIPU_API_KEY 存在时优先走智谱）
# DOUBAO_TTS_API_KEY=控制台 API Key 管理页复制
# DOUBAO_TTS_SPEAKER=控制台音色库选定的 speaker ID（如 40 岁女声）
# DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
# ARK_API_KEY=sk-xxxx
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# ARK_VISION_MODEL=your-vision-model-id
# ARK_TEXT_MODEL=your-text-model-id
