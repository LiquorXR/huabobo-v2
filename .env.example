# 生产部署配置：cp .env.example .env 后填写
# 仅供 docker compose 使用；本地开发改 backend/.env（默认 SQLite 零配置）

# 站点域名（Caddy 自动申请 HTTPS 证书，如 www.example.com）
# DOMAIN=www.example.com

# PostgreSQL（compose 内服务名 postgres，勿改主机名）
POSTGRES_USER=mydb
POSTGRES_PASSWORD=请改为随机强密码
POSTGRES_DB=mydb

# JWT 密钥（生产务必改为随机长字符串）
JWT_SECRET=请改为随机长字符串
# 管理员 token 有效期（默认 7d，如 24h）
# JWT_EXPIRES_IN=7d

# 可选：覆盖内置管理员账号（不填则用 admin / zhijiansu@admin，首次登录后务必改密码）
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=请改为强密码

# 数字人语音 + 识图 + 点评（统一 OpenAI 兼容接口，任选一家服务商）
# 例：智谱 https://open.bigmodel.cn/api/paas/v4，火山方舟 https://ark.cn-beijing.volces.com/api/v3
# OPENAI_API_KEY=sk-xxxx
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 识图和点评共用同一个模型（视觉模型兼容纯文本）；VISION/TEXT 旧变量仍可作别名
# OPENAI_MODEL=glm-5.3-flash
# 思考开关：enabled（thinking 对象，4.6v 系）/ low 等档位（reasoning_effort，5.x 系）/ 留空关闭
# OPENAI_THINKING=low
# OPENAI_TTS_MODEL=glm-tts
# OPENAI_TTS_VOICE=tongtong
# OPENAI_TTS_SPEED=1.0
